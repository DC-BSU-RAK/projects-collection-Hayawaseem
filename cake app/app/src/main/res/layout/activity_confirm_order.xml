<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF3E0"
    android:padding="20dp">

    <!-- 1. BACK BUTTON -->
    <TextView
        android:id="@+id/btnBackConfirm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="←"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#3E2723"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. CENTERED HEADER -->
    <TextView
        android:id="@+id/txtHeaderConfirm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Confirm Order"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#3E2723"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 3. BIG CAKE IMAGE -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardOrderImage"
        android:layout_width="0dp"
        android:layout_height="320dp"
        android:layout_marginTop="30dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/txtHeaderConfirm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgOrderLarge"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/strawberries_chocolate" /> <!-- Default image -->
    </androidx.cardview.widget.CardView>

    <!-- 4. DYNAMIC CAKE DETAILS -->
    <TextView
        android:id="@+id/txtOrderName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Berry Choc Delight"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#3E2723"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/cardOrderImage"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtOrderPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$45.00"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/txtOrderName"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 5. PINNED TOTAL BLOCK (At Bottom) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardTotalBlock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toTopOf="@id/btnCheckout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF">

            <!-- Subtotal Row -->
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:text="Sub total" android:textColor="#8D6E63" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/txtSubtotal" android:text="$45.00" android:textStyle="bold" android:textColor="#3E2723" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true"/>
            </RelativeLayout>

            <!-- Delivery Row -->
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
                <TextView android:text="Delivery Fee" android:textColor="#8D6E63" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/txtDeliveryFee" android:text="$5.00" android:textStyle="bold" android:textColor="#3E2723" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true"/>
            </RelativeLayout>

            <!-- Divider -->
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DDD" android:layout_marginVertical="12dp"/>

            <!-- Total Row -->
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:text="Total" android:textStyle="bold" android:textSize="18sp" android:textColor="#3E2723" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/txtTotal" android:text="$50.00" android:textStyle="bold" android:textSize="18sp" android:textColor="#2E7D32" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true"/>
            </RelativeLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 6. RED CHECKOUT BUTTON (Pinned to Bottom) -->
    <Button
        android:id="@+id/btnCheckout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="PROCEED TO PAYMENT"
        android:backgroundTint="#3E2723"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_marginBottom="10dp"
        app:cornerRadius="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>