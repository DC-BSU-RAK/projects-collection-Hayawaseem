<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.MyApplication" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryVariant">@color/chocolate_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Background color for all screens -->
        <item name="android:windowBackground">@color/bg_cream</item>

        <!-- Text color defaults -->
        <item name="android:textColorPrimary">@color/chocolate_dark</item>

        name="RoundedCorners" parent="ShapeAppearance.MaterialComponents.MediumComponent">
            <item name="cornerFamily">rounded</item>
            <item name="cornerSize">32dp</item>
    </style>

</resources>